# Frontend environment. Copy to frontend/.env for local overrides.

# Leave empty to use the Vite dev proxy (recommended in development).
# In production set the full API base, e.g. https://api.example.com/api/v1
VITE_API_URL=

# Where the dev proxy forwards /api and /health.
VITE_PROXY_TARGET=http://127.0.0.1:8000
