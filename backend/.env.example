# ---------------------------------------------------------------------------
# Backend environment. Copy to backend/.env and edit. NEVER commit backend/.env
# ---------------------------------------------------------------------------

APP_NAME=Investigation Management System
APP_ENV=development
DEBUG=true
APP_TIMEZONE=Asia/Kolkata

# --- Database --------------------------------------------------------------
# Change the password to match your local PostgreSQL installation.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/investigation_db
DB_ECHO=false

# --- Security --------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Super Admin bootstrap (DEVELOPMENT ONLY) ------------------------------
# Created on first `python -m scripts.seed` if it does not already exist.
# Replace these before any production deployment.
SUPER_ADMIN_NAME=Super Administrator
SUPER_ADMIN_EMAIL=admin@investigation.local
SUPER_ADMIN_PASSWORD=Admin@123456

# --- Frontend / CORS -------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage and limits ----------------------------------------------------
MAX_UPLOAD_MB=25
MAX_IMPORT_MB=40

# --- Business defaults (editable later from the Settings screen) -----------
ORGANIZATION_NAME=Virtual Investigation Services
ORGANIZATION_SHORT_NAME=VIPL
STAFF_ONLINE_TIMEOUT_MINUTES=5
DEFAULT_TAT_DAYS=7
TAT_BREACH_WARNING_HOURS=24
DATA_RETENTION_DAYS=90
CASE_NUMBER_PREFIX_INVESTIGATION=INV
CASE_NUMBER_PREFIX_DEATH_CLAIM=DCL
